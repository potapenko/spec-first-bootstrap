{
  "schema_version": 1,
  "node_id": "governance.product-truth",
  "revision": "governance.product-truth.route@1",
  "summary": "Routes product work to the smallest complete governance contract set.",
  "read_when": [
    "work investigates, defines, changes, implements, reviews, or verifies product behavior"
  ],
  "do_not_read_when": [
    "work is proven mechanical, infrastructure-only, or behavior-neutral"
  ],
  "context_budget_words": 900,
  "profiles": {
    "product-question": [
      "governance.product-truth.core",
      "governance.product-truth.routing",
      "governance.product-truth.evidence"
    ],
    "restore": [
      "governance.product-truth.core",
      "governance.product-truth.routing",
      "governance.product-truth.change",
      "governance.product-truth.evidence",
      "governance.product-truth.delivery"
    ],
    "reconcile": [
      "governance.product-truth.core",
      "governance.product-truth.routing",
      "governance.product-truth.change",
      "governance.product-truth.evidence",
      "governance.product-truth.delivery"
    ],
    "evolve": [
      "governance.product-truth.core",
      "governance.product-truth.routing",
      "governance.product-truth.change",
      "governance.product-truth.evidence",
      "governance.product-truth.delivery"
    ],
    "discover": [
      "governance.product-truth.core",
      "governance.product-truth.routing",
      "governance.product-truth.evidence"
    ],
    "product-worker": [
      "governance.product-truth.coordination"
    ],
    "restart": [
      "governance.product-truth.routing",
      "governance.product-truth.coordination"
    ]
  },
  "requires": [],
  "precedence": [],
  "children": [
    {
      "node_id": "governance.product-truth.core",
      "summary": "Canonical product-truth layers, domains, authority, stability, and release protection.",
      "read_when": [
        "any covered product task begins"
      ],
      "do_not_read_when": [
        "the task is proven behavior-neutral"
      ],
      "contract": {
        "path": "core.md",
        "revision": "governance.product-truth.core@1",
        "clauses": [
          "PT.CORE.AUTHORITY",
          "PT.CORE.LAYERS",
          "PT.CORE.DOMAINS",
          "PT.CORE.STABILITY",
          "PT.CORE.RELEASE",
          "PT.CORE.ARTIFACTS"
        ],
        "context_budget_words": 1100,
        "authority": "Active",
        "stability": "Accepted",
        "baseline": "bootstrap.governance@6"
      },
      "requires": [],
      "precedence": []
    },
    {
      "node_id": "governance.product-truth.routing",
      "summary": "Mandatory pre-decision traversal, minimal closure, Route Receipt, and Spec Basis protocol.",
      "read_when": [
        "selecting authority before product evidence or recovering after context loss"
      ],
      "do_not_read_when": [
        "a finite worker packet already contains a pinned complete closure"
      ],
      "contract": {
        "path": "routing-and-basis.md",
        "revision": "governance.product-truth.routing@1",
        "clauses": [
          "PT.ROUTE.TRAVERSE",
          "PT.ROUTE.CLOSURE",
          "PT.ROUTE.RECEIPT",
          "PT.BASIS.PROVISIONAL",
          "PT.BASIS.FINAL"
        ],
        "context_budget_words": 1250,
        "authority": "Active",
        "stability": "Accepted",
        "baseline": "bootstrap.governance@6"
      },
      "requires": [
        {
          "node_id": "governance.product-truth.core",
          "clauses": [
            "PT.CORE.AUTHORITY",
            "PT.CORE.DOMAINS"
          ],
          "reason": "routing selects authority and domain boundaries"
        }
      ],
      "precedence": []
    },
    {
      "node_id": "governance.product-truth.change",
      "summary": "Change modes, Contract Change Envelope, semantic authority, deltas, and protected scope.",
      "read_when": [
        "planning or authorizing product implementation or a semantic specification change"
      ],
      "do_not_read_when": [
        "the task is discovery-only or a question with implementation forbidden"
      ],
      "contract": {
        "path": "change-control.md",
        "revision": "governance.product-truth.change@1",
        "clauses": [
          "PT.CHANGE.MODE",
          "PT.CHANGE.ENVELOPE",
          "PT.CHANGE.AUTHORITY",
          "PT.CHANGE.DELTA",
          "PT.CHANGE.SCOPE"
        ],
        "context_budget_words": 1300,
        "authority": "Active",
        "stability": "Accepted",
        "baseline": "bootstrap.governance@6"
      },
      "requires": [
        {
          "node_id": "governance.product-truth.core",
          "clauses": [
            "PT.CORE.AUTHORITY",
            "PT.CORE.STABILITY",
            "PT.CORE.RELEASE"
          ],
          "reason": "change authority is bounded by active and released contracts"
        }
      ],
      "precedence": []
    },
    {
      "node_id": "governance.product-truth.evidence",
      "summary": "Evidence reconciliation, discrepancy classes, defects, transfers, and brownfield discovery.",
      "read_when": [
        "inspecting source, design, QA, runtime, history, upstream, or release evidence"
      ],
      "do_not_read_when": [
        "the assigned worker only implements from an already reconciled packet"
      ],
      "contract": {
        "path": "evidence-and-profiles.md",
        "revision": "governance.product-truth.evidence@1",
        "clauses": [
          "PT.EVIDENCE.SET",
          "PT.EVIDENCE.DISCREPANCY",
          "PT.PROFILE.DEFECT",
          "PT.PROFILE.TRANSFER",
          "PT.PROFILE.BROWNFIELD"
        ],
        "context_budget_words": 1250,
        "authority": "Active",
        "stability": "Accepted",
        "baseline": "bootstrap.governance@6"
      },
      "requires": [
        {
          "node_id": "governance.product-truth.core",
          "clauses": [
            "PT.CORE.LAYERS",
            "PT.CORE.AUTHORITY"
          ],
          "reason": "evidence layers have distinct authority roles"
        }
      ],
      "precedence": []
    },
    {
      "node_id": "governance.product-truth.delivery",
      "summary": "Spec-first implementation order, design and QA integration, proportionality, and completion.",
      "read_when": [
        "implementing, reviewing, verifying, or completing an authorized product slice"
      ],
      "do_not_read_when": [
        "the task is question-only or discovery-only"
      ],
      "contract": {
        "path": "delivery-and-acceptance.md",
        "revision": "governance.product-truth.delivery@1",
        "clauses": [
          "PT.DELIVERY.ORDER",
          "PT.DELIVERY.DESIGN",
          "PT.DELIVERY.QA",
          "PT.DELIVERY.PROPORTIONALITY",
          "PT.DELIVERY.COMPLETE"
        ],
        "context_budget_words": 1250,
        "authority": "Active",
        "stability": "Accepted",
        "baseline": "bootstrap.governance@6"
      },
      "requires": [
        {
          "node_id": "governance.product-truth.core",
          "clauses": [
            "PT.CORE.AUTHORITY",
            "PT.CORE.RELEASE"
          ],
          "reason": "delivery must preserve the active and released contract"
        }
      ],
      "precedence": []
    },
    {
      "node_id": "governance.product-truth.coordination",
      "summary": "Product worker packets, roles, contract epochs, restart, and compact receipts.",
      "read_when": [
        "coordinating product workers or restoring routed authority after lifecycle events"
      ],
      "do_not_read_when": [
        "ordinary bounded single-agent work has no worker or restart concern"
      ],
      "contract": {
        "path": "coordination-and-lifecycle.md",
        "revision": "governance.product-truth.coordination@1",
        "clauses": [
          "PT.PACKET.CONTEXT",
          "PT.PACKET.ROLES",
          "PT.EPOCH.PIN",
          "PT.LIFECYCLE.RESTORE",
          "PT.RECEIPT.DISCREPANCY"
        ],
        "context_budget_words": 1250,
        "authority": "Active",
        "stability": "Accepted",
        "baseline": "bootstrap.governance@6"
      },
      "requires": [
        {
          "node_id": "governance.product-truth.core",
          "clauses": [
            "PT.CORE.AUTHORITY",
            "PT.CORE.DOMAINS"
          ],
          "reason": "packets preserve authority and protected domain boundaries"
        }
      ],
      "precedence": []
    }
  ]
}
